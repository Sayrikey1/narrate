# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# The key is read from the environment only. It is never written to the
# database, never logged, and never returned by the API.
#
# Nothing here is required to *use* the tool: chunking, cost estimates, the
# whole web UI and every voice audition work without a key, against an offline
# provider that produces real playable audio. A key is needed only for audio
# from the real provider.

# --- ElevenLabs ------------------------------------------------------------
# `ELEVENLABS_API_KEY` and `NARRATE_API_KEY` are accepted as aliases.
ELEVEN_API=

# --- Groq (optional) -------------------------------------------------------
# Only for `narrate effects suggest`, which asks an LLM where effect cues might
# belong. Nothing it proposes is ever generated without you accepting it, and
# the tool works fine without this.
# GROQ_API_KEY=

# --- Overrides (all optional) ---------------------------------------------
# Every Settings field can be set with a NARRATE_ prefix. The ones worth
# knowing about:

# Use the offline provider everywhere, including the web UI. Generation then
# produces real, playable silence and spends nothing.
# NARRATE_PROVIDER=mock

# Where the ledger lives. Defaults to a managed location outside the project:
#   macOS, Linux   ~/.local/share/narrate/narrate.db
#   Windows        %LOCALAPPDATA%\narrate\narrate.db
# See `narrate db status`.
# NARRATE_DB_PATH=

# Where generated audio is written. Defaults to ./assets
# NARRATE_ASSETS_DIR=

# Concurrent requests. Conservative by default — exceeding the account's limit
# produces rejections rather than queuing. Raise it only after
# `narrate models --sync` reports the account's real ceiling.
# NARRATE_CONCURRENCY=2

# Silence inserted between chunks on export, in seconds.
# NARRATE_GAP_SECONDS=0.4
